{
    "$schema": ".kcode/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 20,
    "phpUnit": {
        "customPath": ".kcode/vendor/bin/phpunit"
    },
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log"
    },
    "initialTestsPhpOptions": "-d apc.enable_cli=1 -d pcov.enabled=1",
    "testFrameworkOptions": "--testsuite=Unit,Integration",
    "mutators": {
        "@default": true
    },
    "minMsi": 80,
    "minCoveredMsi": 80
}
