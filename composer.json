{
    "name": "kariricode/cache",
    "description": "Multi-tier cache for PHP 8.4+: SIEVE eviction, XFetch probabilistic early recomputation, stale-while-revalidate, tag invalidation and PSR-6/PSR-16 bridges. Zero runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cache",
        "psr-6",
        "psr-16",
        "sieve",
        "xfetch",
        "stale-while-revalidate",
        "stampede-prevention",
        "tag-invalidation",
        "multi-tier",
        "kariricode"
    ],
    "homepage": "https://kariricode.org",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.11",
        "psr/clock": "^1.0"
    },
    "suggest": {
        "ext-apcu": "Required by ApcuAdapter (shared-memory cache)",
        "ext-igbinary": "Required by IgbinarySerializer (compact binary serialization)",
        "ext-redis": "Required by RedisAdapter (distributed, persistent cache)",
        "ext-zlib": "Required by ZlibCompressor",
        "psr/cache": "Required by Psr6Bridge (PSR-6 interoperability)",
        "psr/simple-cache": "Required by Psr16Bridge (PSR-16 interoperability)"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "kcode test --testsuite=Unit",
        "test-integration": "kcode test --testsuite=Integration",
        "test-conformance": "kcode test --testsuite=Conformance",
        "test-coverage": "kcode test --coverage-text",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache --no-progress",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "complexity": "@php tools/complexity.php src",
        "infection": "kcode run infection --threads=max --no-progress",
        "security": [
            "@composer validate --strict --no-check-publish",
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php --self-test",
            "@php tools/secret-scan.php",
            "kcode test --group=security"
        ],
        "sbom": "@php tools/sbom.php",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@test-conformance",
            "@security"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "component": "cache",
            "spec": "4.3.3",
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "error-code-range": "8600–8699"
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "support": {
        "issues": "https://github.com/KaririCode-PHP/cache/issues",
        "source": "https://github.com/KaririCode-PHP/cache"
    }
}
