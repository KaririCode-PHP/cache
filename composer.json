{
  "name": "kariricode/cache",
  "description": "A flexible and efficient caching library for PHP with support for multiple drivers and plugin system",
  "keywords": [
    "cache",
    "caching",
    "psr-6",
    "psr-16",
    "redis",
    "memcached",
    "file-cache",
    "multi-layer-cache",
    "plugin-system",
    "php",
    "framework",
    "kariri"
  ],
  "homepage": "https://kariricode.org",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Walmir Silva",
      "email": "community@kariricode.org"
    }
  ],
  "require": {
    "php": "^8.3",
    "psr/simple-cache": "^3.0",
    "psr/cache": "^3.0",
    "kariricode/exception": "1.2.4",
    "kariricode/configurator": "1.0.0",
    "kariricode/dotenv": "1.1.2",
    "kariricode/contract": "2.8.3",
    "kariricode/logging": "1.1.0",
    "kariricode/data-structure": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "KaririCode\\Cache\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KaririCode\\Cache\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.51",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.9",
    "enlightn/security-checker": "^2.0"
  },
  "support": {
    "issues": "https://github.com/KaririCode-Framework/kariricode-cache/issues",
    "source": "https://github.com/KaririCode-Framework/kariricode-cache"
  }
}
