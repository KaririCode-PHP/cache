# =============================================================================
# KaririCode Cache Configuration Environment Variables
# Copy this file to .env and adjust values for your environment
# =============================================================================
APP_ENV=develop
PHP_VERSION=8.3
PHP_PORT=9003

# -----------------------------------------------------------------------------
# CORE CACHE SETTINGS
# -----------------------------------------------------------------------------
CACHE_DEFAULT_STORE=layered
CACHE_SERIALIZER=igbinary
CACHE_DEFAULT_TTL=3600
CACHE_DEFAULT_PREFIX=""
CACHE_NAMESPACE_SEPARATOR=":"

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_CACHE_DB=1
REDIS_PERSISTENT=true
REDIS_PERSISTENT_ID=kariricode_cache
REDIS_COMPRESSION=true
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0

# Redis Prefixes
CACHE_REDIS_PREFIX="cache:"
CACHE_REDIS_TAG_PREFIX="tag:"
CACHE_REDIS_TOPIC_PREFIX="topic:"

# Redis Optimizations
REDIS_PIPELINE_OPS=true
REDIS_CLUSTER_MODE=false
REDIS_SENTINEL_MODE=false
REDIS_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# MEMCACHED CONFIGURATION
# -----------------------------------------------------------------------------
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=kariricode_cache
MEMCACHED_COMPRESSION=true
MEMCACHED_SERIALIZER=igbinary
MEMCACHED_CONNECT_TIMEOUT=1
MEMCACHED_POLL_TIMEOUT=1
MEMCACHED_RECV_TIMEOUT=1
MEMCACHED_SEND_TIMEOUT=1

# Memcached Prefixes
CACHE_MEMCACHED_PREFIX="cache:"

# Memcached Optimizations
MEMCACHED_CONSISTENT_HASHING=true
MEMCACHED_BINARY_PROTOCOL=true
MEMCACHED_TCP_NODELAY=true

# -----------------------------------------------------------------------------
# FILESYSTEM CACHE CONFIGURATION
# -----------------------------------------------------------------------------
CACHE_FILESYSTEM_DIR="/tmp/kariricode-cache"
CACHE_FILESYSTEM_PREFIX="fs_"
CACHE_FILESYSTEM_MAX_SIZE=104857600
CACHE_CLEANUP_PROBABILITY=0.01

# Filesystem Optimizations
FILESYSTEM_ATOMIC_WRITES=true
FILESYSTEM_FILE_LOCKING=true
FILESYSTEM_DIR_LEVELS=2

# -----------------------------------------------------------------------------
# APCU CONFIGURATION
# -----------------------------------------------------------------------------
CACHE_APCU_PREFIX="apcu:"

# -----------------------------------------------------------------------------
# FEATURE TOGGLES
# -----------------------------------------------------------------------------
CACHE_STAMPEDE_PROTECTION=true
CACHE_METRICS_ENABLED=true
CACHE_SLIDING_EXPIRATION=false
CACHE_EVENTS_ENABLED=true
CACHE_PSR14_EVENTS_ENABLED=false
CACHE_STRICT_VALIDATION=true

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
CACHE_RATE_LIMIT=1000
CACHE_WHITELISTED_IPS="127.0.0.1,::1"
CACHE_AUDIT_SALT="change_this_in_production_for_security"
CACHE_ENABLE_GEO_LOCATION=false
CACHE_AUDIT_RETENTION_DAYS=30
CACHE_MAX_KEY_LENGTH=250
CACHE_MAX_VALUE_SIZE=1048576

# -----------------------------------------------------------------------------
# OBSERVABILITY AND MONITORING
# -----------------------------------------------------------------------------
CACHE_PERFORMANCE_TRACKING=true
CACHE_SECURITY_MONITORING=false
CACHE_MAX_EVENTS=1000
CACHE_SLOW_THRESHOLD=0.1
CACHE_DEBUG_LOGGING=false
CACHE_METRICS_INTERVAL=60

# -----------------------------------------------------------------------------
# SPECIALIZED CACHE DATABASES
# -----------------------------------------------------------------------------
# Session Cache
SESSION_REDIS_HOST=${REDIS_HOST}
SESSION_REDIS_PORT=${REDIS_PORT}
SESSION_REDIS_PASSWORD=${REDIS_PASSWORD}
SESSION_REDIS_DB=2
SESSION_CACHE_PREFIX="sess:"

# API Response Cache
API_CACHE_REDIS_DB=3

# -----------------------------------------------------------------------------
# HEALTH CHECKS
# -----------------------------------------------------------------------------
CACHE_HEALTH_CHECKS=true
CACHE_HEALTH_CHECK_INTERVAL=300
CACHE_HEALTH_CHECK_TIMEOUT=5
CACHE_HEALTH_CHECK_STORES="redis,memcached"

# -----------------------------------------------------------------------------
# STORAGE PATHS
# -----------------------------------------------------------------------------
STORAGE_PATH="/var/www/storage"
