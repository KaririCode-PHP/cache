# =============================================================================
# KaririCode Cache Configuration Environment Variables
# Copy this file to .env and adjust values for your environment
# =============================================================================
APP_ENV=develop
PHP_VERSION=8.3
PHP_PORT=9003

# =============================================================================
# CORE CACHE SETTINGS
# =============================================================================
CACHE_DEFAULT_STORE=layered
CACHE_SERIALIZER=igbinary
CACHE_DEFAULT_TTL=3600

# =============================================================================
# EXPIRATION PROVIDER CONFIGURATION (NEW ARCHITECTURE)
# =============================================================================

# Operation-specific TTLs (in seconds)
CACHE_SET_TTL=1800              # 30 minutes for regular sets
CACHE_SET_MULTIPLE_TTL=1800     # 30 minutes for batch sets
CACHE_ADD_TTL=1800              # 30 minutes for add operations
CACHE_INCREMENT_TTL=7200        # 2 hours for counters
CACHE_DECREMENT_TTL=7200        # 2 hours for counters
CACHE_TAGGED_TTL=900            # 15 minutes for tagged items
CACHE_CAS_TTL=1800              # 30 minutes for compare-and-swap

# Key pattern-specific TTLs (in seconds)
SESSION_TTL=7200                # 2 hours for sessions
API_CACHE_TTL=1800              # 30 minutes for API responses
USER_CACHE_TTL=900              # 15 minutes for user data
TEMP_CACHE_TTL=300              # 5 minutes for temporary data
CONFIG_CACHE_TTL=3600           # 1 hour for configuration
COUNTER_CACHE_TTL=86400         # 24 hours for counters
CRITICAL_CACHE_TTL=60           # 1 minute for critical data
ANALYTICS_CACHE_TTL=21600       # 6 hours for analytics
GENERAL_CACHE_TTL=3600          # 1 hour for general cache

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_CACHE_DB=1
REDIS_PERSISTENT=true
REDIS_PERSISTENT_ID=kariricode_cache
REDIS_COMPRESSION=true
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0

# Redis Prefixes
CACHE_REDIS_PREFIX="cache:"
CACHE_REDIS_TAG_PREFIX="tag:"
CACHE_REDIS_TOPIC_PREFIX="topic:"

# Redis Optimizations
REDIS_PIPELINE_OPS=true
REDIS_CLUSTER_MODE=false
REDIS_SENTINEL_MODE=false
REDIS_MAX_CONNECTIONS=20
REDIS_POOL_SIZE=10
REDIS_LUA_SCRIPTS=true

# =============================================================================
# MEMCACHED CONFIGURATION
# =============================================================================
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
MEMCACHED_WEIGHT=100
MEMCACHED_PERSISTENT_ID=kariricode_cache
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_COMPRESSION=true
MEMCACHED_SERIALIZER=igbinary
CACHE_MEMCACHED_PREFIX="cache:"
MEMCACHED_CONNECT_TIMEOUT=1
MEMCACHED_POLL_TIMEOUT=1
MEMCACHED_RECV_TIMEOUT=1
MEMCACHED_SEND_TIMEOUT=1

# Memcached Optimizations
MEMCACHED_CONSISTENT_HASHING=true
MEMCACHED_BINARY_PROTOCOL=true
MEMCACHED_TCP_NODELAY=true
MEMCACHED_KETAMA_HASHING=true
MEMCACHED_BUFFER_WRITES=true

# =============================================================================
# FILESYSTEM CACHE CONFIGURATION
# =============================================================================
CACHE_FILESYSTEM_DIR=storage/cache
CACHE_FILESYSTEM_PREFIX="fs_"
CACHE_FILESYSTEM_MAX_SIZE=104857600  # 100MB
CACHE_CLEANUP_PROBABILITY=0.01

# Filesystem Optimizations
FILESYSTEM_ATOMIC_WRITES=true
FILESYSTEM_FILE_LOCKING=true
FILESYSTEM_DIR_LEVELS=2
FILESYSTEM_PERMISSIONS=0644
FILESYSTEM_DIR_PERMISSIONS=0755

# =============================================================================
# APCU CONFIGURATION
# =============================================================================
CACHE_APCU_PREFIX="apcu:"
APCU_ENABLE_SERIALIZER=true
APCU_SLAM_DEFENSE=true
APCU_USER_CACHE_ONLY=true

# =============================================================================
# FEATURE TOGGLES
# =============================================================================
CACHE_STAMPEDE_PROTECTION=true
CACHE_METRICS_ENABLED=true
CACHE_SLIDING_EXPIRATION=false
CACHE_EVENTS_ENABLED=true
CACHE_PSR14_EVENTS_ENABLED=false
CACHE_STRICT_VALIDATION=true
CACHE_COMPRESSION_ENABLED=true
CACHE_ATOMIC_OPERATIONS=true
CACHE_TAGGED_OPERATIONS=true
CACHE_TOPIC_SUBSCRIPTIONS=true

# =============================================================================
# SERIALIZATION
# =============================================================================
CACHE_COMPRESSION_LEVEL=6

# =============================================================================
# CONTEXT CONFIGURATION (NEW ARCHITECTURE)
# =============================================================================
CACHE_MAX_TTL_OVERRIDE=86400     # 24 hours max override
CACHE_MIN_TTL_OVERRIDE=1         # 1 second min override
CACHE_MAX_TAGS_PER_ITEM=20       # Max tags per cache item
CACHE_MAX_TOPICS_PER_ITEM=10     # Max topics per cache item

# =============================================================================
# DEFAULT SETTINGS
# =============================================================================
CACHE_DEFAULT_PREFIX=""
CACHE_NAMESPACE_SEPARATOR=":"
CACHE_MAX_KEY_LENGTH=250
CACHE_MAX_VALUE_SIZE=1048576     # 1MB

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
CACHE_RATE_LIMIT=1000
CACHE_WHITELISTED_IPS="127.0.0.1,::1"
CACHE_AUDIT_SALT="change_this_in_production_env"
CACHE_ENABLE_GEO_LOCATION=false
CACHE_AUDIT_RETENTION_DAYS=30
CACHE_ENABLE_ENCRYPTION=false
CACHE_ENCRYPTION_KEY=
CACHE_ENCRYPTION_CIPHER="AES-256-GCM"

# =============================================================================
# OBSERVABILITY AND MONITORING
# =============================================================================
CACHE_PERFORMANCE_TRACKING=true
CACHE_SECURITY_MONITORING=false
CACHE_MAX_EVENTS=1000
CACHE_SLOW_THRESHOLD=0.1         # 100ms
CACHE_DEBUG_LOGGING=false
CACHE_METRICS_INTERVAL=60        # seconds
CACHE_ENABLE_PROFILING=false
CACHE_PROFILING_SAMPLE_RATE=0.01

# =============================================================================
# HEALTH CHECKS
# =============================================================================
CACHE_HEALTH_CHECKS=true
CACHE_HEALTH_CHECK_INTERVAL=300  # 5 minutes
CACHE_HEALTH_CHECK_TIMEOUT=5     # 5 seconds
CACHE_HEALTH_CHECK_STORES="redis,memcached"
CACHE_HEALTH_FAILURE_THRESHOLD=3
CACHE_HEALTH_RECOVERY_THRESHOLD=2
CACHE_HEALTH_CHECK_CONNECTIVITY=true
CACHE_HEALTH_CHECK_READ_WRITE=true

# -----------------------------------------------------------------------------
# SPECIALIZED CACHE DATABASES
# -----------------------------------------------------------------------------
# Session Cache
SESSION_REDIS_HOST=${REDIS_HOST}
SESSION_REDIS_PORT=${REDIS_PORT}
SESSION_REDIS_PASSWORD=${REDIS_PASSWORD}
SESSION_REDIS_DB=2
SESSION_CACHE_PREFIX="sess:"

# API Response Cache
API_CACHE_REDIS_DB=3

# -----------------------------------------------------------------------------
# HEALTH CHECKS
# -----------------------------------------------------------------------------
CACHE_HEALTH_CHECKS=true
CACHE_HEALTH_CHECK_INTERVAL=300
CACHE_HEALTH_CHECK_TIMEOUT=5
CACHE_HEALTH_CHECK_STORES="redis,memcached"

# -----------------------------------------------------------------------------
# STORAGE PATHS
# -----------------------------------------------------------------------------
STORAGE_PATH="/var/www/storage"
