# =============================================================================
# KaririCode Cache Configuration Environment Variables
# =============================================================================

#--------------------------------------------------------------------------
# Ambiente da Aplicação e Docker
#--------------------------------------------------------------------------
APP_ENV=develop
PHP_VERSION=8.3
PHP_PORT=9003

# =============================================================================
# CONFIGURAÇÕES PRINCIPAIS DE CACHE
# =============================================================================
CACHE_DEFAULT_STORE=layered
CACHE_SERIALIZER=igbinary
CACHE_DEFAULT_TTL=3600
CACHE_DEFAULT_PREFIX=""
CACHE_NAMESPACE_SEPARATOR=":"

# =============================================================================
# CONFIGURAÇÃO DO PROVEDOR DE EXPIRAÇÃO
# =============================================================================

# TTLs (Time-To-Live) específicos por operação (em segundos)
CACHE_SET_TTL=1800              # 30 minutos
CACHE_SET_MULTIPLE_TTL=1800     # 30 minutos
CACHE_ADD_TTL=1800              # 30 minutos
CACHE_INCREMENT_TTL=7200        # 2 horas
CACHE_DECREMENT_TTL=7200        # 2 horas
CACHE_TAGGED_TTL=900            # 15 minutos
CACHE_CAS_TTL=1800              # 30 minutos

# TTLs específicos por padrão de chave (em segundos)
SESSION_TTL=7200                # 2 horas
API_CACHE_TTL=1800              # 30 minutos
USER_CACHE_TTL=900              # 15 minutos
TEMP_CACHE_TTL=300              # 5 minutos
CONFIG_CACHE_TTL=3600           # 1 hora
COUNTER_CACHE_TTL=86400         # 24 horas
CRITICAL_CACHE_TTL=60           # 1 minuto
ANALYTICS_CACHE_TTL=21600       # 6 horas

# =============================================================================
# CONFIGURAÇÃO DO REDIS
# O anfitrião (host) deve ser o nome do serviço no docker-compose.yml
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password_seguro_para_redis # Altere esta senha!
REDIS_USERNAME=
REDIS_CACHE_DB=1
REDIS_PERSISTENT=true
REDIS_PERSISTENT_ID=kariricode_cache
REDIS_COMPRESSION=true
REDIS_TIMEOUT=2.0
REDIS_READ_TIMEOUT=2.0

# Prefixos do Redis
CACHE_REDIS_PREFIX="cache:"
CACHE_REDIS_TAG_PREFIX="tag:"
CACHE_REDIS_TOPIC_PREFIX="topic:"

# Otimizações do Redis
REDIS_PIPELINE_OPS=true
REDIS_LUA_SCRIPTS=true
REDIS_PIPELINE_BATCH_SIZE=100
REDIS_SCAN_COUNT=100
REDIS_LUA_CACHE=true

# =============================================================================
# CONFIGURAÇÃO DO MEMCACHED
# O anfitrião (host) deve ser o nome do serviço no docker-compose.yml
# =============================================================================
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
MEMCACHED_WEIGHT=100
MEMCACHED_PERSISTENT_ID=kariricode_cache
MEMCACHED_USERNAME=user    # Altere este utilizador!
MEMCACHED_PASSWORD=password_seguro_para_memcached # Altere esta senha!
MEMCACHED_COMPRESSION=true
MEMCACHED_SERIALIZER=igbinary
CACHE_MEMCACHED_PREFIX="cache:"

# Otimizações do Memcached
MEMCACHED_CONSISTENT_HASHING=true
MEMCACHED_BINARY_PROTOCOL=true
MEMCACHED_TCP_NODELAY=true
MEMCACHED_BUFFER_WRITES=true
MEMCACHED_CAS_TOKENS=true
MEMCACHED_NO_BLOCK=true

# =============================================================================
# CONFIGURAÇÃO DE CACHE DO SISTEMA DE FICHEIROS (FILESYSTEM)
# =============================================================================
CACHE_FILESYSTEM_DIR=storage/cache
CACHE_FILESYSTEM_PREFIX="fs_"
CACHE_FILESYSTEM_MAX_SIZE=104857600  # 100MB
CACHE_CLEANUP_PROBABILITY=0.01

# Otimizações do Filesystem
FILESYSTEM_ATOMIC_WRITES=true
FILESYSTEM_FILE_LOCKING=true
FILESYSTEM_DIR_LEVELS=2
FILESYSTEM_COMPRESSION=false
FILESYSTEM_META_CACHE=true
FILESYSTEM_DIR_PERMISSIONS=0755
FILESYSTEM_FILE_PERMISSIONS=0644

# =============================================================================
# CONFIGURAÇÃO DO APCU
# =============================================================================
CACHE_APCU_PREFIX="apcu:"
APCU_ENABLE_STATISTICS=true
APCU_CLEANUP_PROBABILITY=0.01
APCU_SLAM_DEFENSE=true
APCU_PRELOAD=false

# =============================================================================
# ATIVAÇÃO DE FUNCIONALIDADES (FEATURE TOGGLES)
# =============================================================================
CACHE_DEBUG_MODE=false
CACHE_STAMPEDE_PROTECTION=true
CACHE_METRICS_ENABLED=true
CACHE_EVENTS_ENABLED=true
CACHE_STRICT_VALIDATION=true
CACHE_COMPRESSION_ENABLED=true
CACHE_ASYNC_OPERATIONS=false
CACHE_SLIDING_EXPIRATION=false
CACHE_ENCRYPTION_ENABLED=false
CACHE_ENCRYPTION_KEY=

# =============================================================================
# CONFIGURAÇÃO DE VALIDAÇÃO E SEGURANÇA
# =============================================================================
CACHE_MAX_KEY_LENGTH=250
CACHE_MAX_VALUE_SIZE=2097152 # 2MB
CACHE_RESERVED_CHARACTERS='{}()/\@:'
CACHE_KEY_PATTERN='/^[a-zA-Z0-9_\-\.]+$/'
CACHE_ENABLE_ENCRYPTION=false
CACHE_ENCRYPTION_KEY=
CACHE_ENCRYPTION_CIPHER="AES-256-GCM"

# =============================================================================
# MÉTRICAS, LOGS E VERIFICAÇÃO DE SAÚDE (HEALTH CHECKS)
# =============================================================================
# Métricas
CACHE_METRICS_COLLECTOR='default'
CACHE_METRICS_FORMAT='json'
CACHE_METRICS_INTERVAL=60
CACHE_METRICS_DRIVER_STATS=true

# Logs
CACHE_LOGGING_ENABLED=true
CACHE_LOG_CHANNEL='cache'
CACHE_LOG_LEVEL='info'
CACHE_LOG_VALUES=false
CACHE_LOG_MAX_VALUE_LENGTH=100

# Verificação de Saúde
CACHE_HEALTH_CHECKS=true
CACHE_HEALTH_CHECK_INTERVAL=300
CACHE_HEALTH_CHECK_TIMEOUT=5
CACHE_HEALTH_CHECK_STORES="redis,memcached"
CACHE_HEALTH_FAILURE_THRESHOLD=3
CACHE_HEALTH_RECOVERY_THRESHOLD=2

